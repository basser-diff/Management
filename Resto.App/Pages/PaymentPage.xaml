<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Resto.App.Pages.PaymentPage"
             Title="Payment"
             BackgroundColor="#f4f6fb"
             Shell.NavBarIsVisible="True">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="#b71c1c" Padding="20,16"
              ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="Card Payment 💳" FontSize="22" FontAttributes="Bold" TextColor="White"/>
                <Label x:Name="AmountLabel" FontSize="13" TextColor="#CCFFFFFF"/>
            </VerticalStackLayout>
            <!-- Security badge -->
            <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                <Label Text="🔒" FontSize="16" VerticalOptions="Center"/>
                <Label Text="AES-256" FontSize="11" TextColor="#CCFFFFFF" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,16" Spacing="16">

                <!-- ── Processing overlay ────────────────────────────── -->
                <Grid x:Name="ProcessingOverlay" IsVisible="False"
                      HeightRequest="200" VerticalOptions="Center">
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="16">
                        <ActivityIndicator IsRunning="True" Color="#b71c1c" WidthRequest="48" HeightRequest="48"/>
                        <Label Text="Processing payment..." FontSize="15" FontAttributes="Bold"
                               TextColor="#555" HorizontalOptions="Center"/>
                        <Label Text="Please do not close the app." FontSize="12"
                               TextColor="#aaa" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- ── Success screen ─────────────────────────────────── -->
                <VerticalStackLayout x:Name="SuccessView" IsVisible="False"
                                     Spacing="16" Padding="0,10">
                    <Border BackgroundColor="White" StrokeThickness="0" Padding="24">
                        <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                            <!-- Green tick -->
                            <Border BackgroundColor="#E8F5E9" StrokeThickness="0"
                                    WidthRequest="80" HeightRequest="80"
                                    HorizontalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="40"/></Border.StrokeShape>
                                <Label Text="✅" FontSize="40"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Text="Payment Successful!" FontSize="20" FontAttributes="Bold"
                                   TextColor="#1a1a1a" HorizontalOptions="Center"/>
                            <Label x:Name="SuccessAmountLabel" FontSize="28" FontAttributes="Bold"
                                   TextColor="#b71c1c" HorizontalOptions="Center"/>
                            <!-- Receipt details -->
                            <BoxView HeightRequest="1" Color="#f0f0f0"/>
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                                <Label Grid.Row="0" Grid.Column="0" Text="Transaction ID"
                                       FontSize="12" TextColor="#888"/>
                                <Label Grid.Row="0" Grid.Column="1" x:Name="TxnIdLabel"
                                       FontSize="11" TextColor="#333" FontAttributes="Bold"
                                       HorizontalTextAlignment="End"/>

                                <Label Grid.Row="1" Grid.Column="0" Text="Card"
                                       FontSize="12" TextColor="#888"/>
                                <Label Grid.Row="1" Grid.Column="1" x:Name="MaskedCardLabel"
                                       FontSize="12" TextColor="#333" FontAttributes="Bold"
                                       HorizontalTextAlignment="End"/>

                                <Label Grid.Row="2" Grid.Column="0" Text="Card Type"
                                       FontSize="12" TextColor="#888"/>
                                <Label Grid.Row="2" Grid.Column="1" x:Name="CardTypeLabel"
                                       FontSize="12" TextColor="#333" FontAttributes="Bold"
                                       HorizontalTextAlignment="End"/>

                                <Label Grid.Row="3" Grid.Column="0" Text="Date"
                                       FontSize="12" TextColor="#888"/>
                                <Label Grid.Row="3" Grid.Column="1" x:Name="ProcessedAtLabel"
                                       FontSize="11" TextColor="#333"
                                       HorizontalTextAlignment="End"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="#f0f0f0"/>
                            <Button Text="View My Orders 📋"
                                    BackgroundColor="#b71c1c" TextColor="White"
                                    CornerRadius="12" Padding="0,14"
                                    HorizontalOptions="Fill"
                                    Clicked="OnViewOrdersClicked"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ── Failure screen ─────────────────────────────────── -->
                <VerticalStackLayout x:Name="FailureView" IsVisible="False"
                                     Spacing="16" Padding="0,10">
                    <Border BackgroundColor="White" StrokeThickness="0" Padding="24">
                        <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                            <Border BackgroundColor="#FFEBEE" StrokeThickness="0"
                                    WidthRequest="80" HeightRequest="80"
                                    HorizontalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="40"/></Border.StrokeShape>
                                <Label Text="❌" FontSize="40"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Text="Payment Failed" FontSize="20" FontAttributes="Bold"
                                   TextColor="#1a1a1a" HorizontalOptions="Center"/>
                            <Label x:Name="FailureMessageLabel" FontSize="14"
                                   TextColor="#555" HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" LineBreakMode="WordWrap"/>
                            <Button Text="Try Again" BackgroundColor="#b71c1c" TextColor="White"
                                    CornerRadius="12" Padding="0,14" HorizontalOptions="Fill"
                                    Clicked="OnTryAgainClicked"/>
                            <Button Text="Pay with Cash on Pick-Up"
                                    BackgroundColor="White" TextColor="#b71c1c"
                                    BorderColor="#b71c1c" BorderWidth="1.5"
                                    CornerRadius="12" Padding="0,14" HorizontalOptions="Fill"
                                    Clicked="OnSwitchToCOPClicked"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ── Card entry form ───────────────────────────────── -->
                <VerticalStackLayout x:Name="FormView" Spacing="16">

                    <!-- Security notice -->
                    <Border BackgroundColor="#E8F5E9" StrokeThickness="0" Padding="14,10">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="🔒" FontSize="18" VerticalOptions="Center"/>
                            <Label Text="Your card details are encrypted with AES-256 before transmission. We never store your raw card data."
                                   FontSize="11" TextColor="#2e7d32" LineBreakMode="WordWrap"
                                   HorizontalOptions="FillAndExpand" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Card visual preview -->
                    <Border StrokeThickness="0" Padding="20,18">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#b71c1c" Offset="0"/>
                                <GradientStop Color="#7f0000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
           Text="🍽️ RESTO Card"
           FontSize="14"
           TextColor="White"
           FontAttributes="Bold"
           VerticalOptions="Center"/>

                                <Label Grid.Column="1"
           x:Name="CardTypePreview"
           Text=""
           FontSize="14"
           TextColor="White"
           FontAttributes="Bold"
           HorizontalOptions="End"
           VerticalOptions="Center"/>
                            </Grid>
                            <Label Grid.Row="1" x:Name="CardNumberPreview"
                                   Text="•••• •••• •••• ••••"
                                   FontSize="20" FontAttributes="Bold"
                                   TextColor="White" CharacterSpacing="2"
                                   HorizontalOptions="Center" Margin="0,8"/>
                            <Grid Grid.Row="2" ColumnDefinitions="*,*">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="CARDHOLDER" FontSize="9"
                                           TextColor="#CCFFFFFF" CharacterSpacing="1"/>
                                    <Label x:Name="HolderPreview" Text="FULL NAME"
                                           FontSize="13" TextColor="White" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                                    <Label Text="EXPIRES" FontSize="9"
                                           TextColor="#CCFFFFFF" CharacterSpacing="1"/>
                                    <Label x:Name="ExpiryPreview" Text="MM/YY"
                                           FontSize="13" TextColor="White" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Card Number -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Card Number" FontSize="13" FontAttributes="Bold"
                               TextColor="#444"/>
                        <Border BackgroundColor="White" StrokeThickness="1.5"
                                x:Name="CardNumberBorder" Stroke="#ddd" Padding="14,12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry Grid.Column="0"
                                       x:Name="CardNumberEntry"
                                       Placeholder="1234 5678 9012 3456"
                                       PlaceholderColor="#bbb"
                                       Keyboard="Numeric"
                                       MaxLength="19"
                                       BackgroundColor="Transparent"
                                       FontSize="15"
                                       TextChanged="OnCardNumberChanged"/>
                                <Label Grid.Column="1" x:Name="CardNetworkIcon"
                                       Text="" FontSize="22" VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                        <Label x:Name="CardNumberError" Text="" FontSize="11"
                               TextColor="#d32f2f" IsVisible="False"/>
                    </VerticalStackLayout>

                    <!-- Cardholder Name -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Cardholder Name" FontSize="13" FontAttributes="Bold"
                               TextColor="#444"/>
                        <Border BackgroundColor="White" StrokeThickness="1.5"
                                x:Name="NameBorder" Stroke="#ddd" Padding="14,12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Entry x:Name="CardholderEntry"
                                   Placeholder="As printed on card"
                                   PlaceholderColor="#bbb"
                                   Keyboard="Default"
                                   BackgroundColor="Transparent"
                                   FontSize="15"
                                   TextChanged="OnHolderNameChanged"/>
                        </Border>
                        <Label x:Name="NameError" Text="" FontSize="11"
                               TextColor="#d32f2f" IsVisible="False"/>
                    </VerticalStackLayout>

                    <!-- Expiry + CVV row -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <!-- Expiry -->
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Expiry Date" FontSize="13" FontAttributes="Bold"
                                   TextColor="#444"/>
                            <Border BackgroundColor="White" StrokeThickness="1.5"
                                    x:Name="ExpiryBorder" Stroke="#ddd" Padding="14,12">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                <Entry x:Name="ExpiryEntry"
                                       Placeholder="MM/YY"
                                       PlaceholderColor="#bbb"
                                       Keyboard="Numeric"
                                       MaxLength="5"
                                       BackgroundColor="Transparent"
                                       FontSize="15"
                                       TextChanged="OnExpiryChanged"/>
                            </Border>
                            <Label x:Name="ExpiryError" Text="" FontSize="11"
                                   TextColor="#d32f2f" IsVisible="False"/>
                        </VerticalStackLayout>
                        <!-- CVV -->
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="CVV" FontSize="13" FontAttributes="Bold"
                                   TextColor="#444"/>
                            <Border BackgroundColor="White" StrokeThickness="1.5"
                                    x:Name="CvvBorder" Stroke="#ddd" Padding="14,12">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry Grid.Column="0"
                                           x:Name="CvvEntry"
                                           Placeholder="•••"
                                           PlaceholderColor="#bbb"
                                           Keyboard="Numeric"
                                           MaxLength="4"
                                           IsPassword="True"
                                           BackgroundColor="Transparent"
                                           FontSize="15"
                                           TextChanged="OnCvvChanged"/>
                                    <Label Grid.Column="1" Text="ℹ️" FontSize="16"
                                           VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnCvvInfoTapped"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Border>
                            <Label x:Name="CvvError" Text="" FontSize="11"
                                   TextColor="#d32f2f" IsVisible="False"/>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Global error banner -->
                    <Border x:Name="GlobalErrorBanner" IsVisible="False"
                            BackgroundColor="#FFEBEE" StrokeThickness="0" Padding="14,10">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="⚠️" FontSize="16" VerticalOptions="Center"/>
                            <Label x:Name="GlobalErrorLabel" FontSize="13" TextColor="#d32f2f"
                                   LineBreakMode="WordWrap" HorizontalOptions="FillAndExpand"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Accepted cards -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="12">
                        <Label Text="Visa" FontSize="13" TextColor="#1565c0"
                               FontAttributes="Bold" VerticalOptions="Center"/>
                        <Label Text="•" TextColor="#ccc" VerticalOptions="Center"/>
                        <Label Text="MasterCard" FontSize="13" TextColor="#ff6f00"
                               FontAttributes="Bold" VerticalOptions="Center"/>
                        <Label Text="•" TextColor="#ccc" VerticalOptions="Center"/>
                        <Label Text="Amex" FontSize="13" TextColor="#0d47a1"
                               FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <!-- Pay button -->
                    <Button x:Name="PayButton"
                            Text="Pay Now"
                            FontSize="16" FontAttributes="Bold"
                            BackgroundColor="#b71c1c" TextColor="White"
                            CornerRadius="14" Padding="0,16"
                            Clicked="OnPayClicked"/>

                    <!-- Test card hint -->
                    <Border BackgroundColor="#FFF8E1" StrokeThickness="0" Padding="12,8">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="🧪 Test Cards" FontSize="11" FontAttributes="Bold"
                                   TextColor="#e65100"/>
                            <Label Text="Success: 4111 1111 1111 1111  •  Exp: 12/29  •  CVV: 123"
                                   FontSize="10" TextColor="#bf360c"/>
                            <Label Text="Decline: 4000 0000 0000 0002  •  Exp: 12/29  •  CVV: 123"
                                   FontSize="10" TextColor="#bf360c"/>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
