<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Resto.App.Pages.CartPage"
             Title="My Cart"
             BackgroundColor="#f4f6fb">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" BackgroundColor="#b71c1c" Padding="20,16">
            <Label Text="My Cart 🛒" FontSize="22" FontAttributes="Bold" TextColor="White"/>
            <Label x:Name="CartSubtitle" FontSize="12" TextColor="#CCFFFFFF"/>
        </VerticalStackLayout>

        <!-- Empty state -->
        <VerticalStackLayout Grid.Row="1" x:Name="EmptyState"
                             IsVisible="False"
                             VerticalOptions="Center" HorizontalOptions="Center"
                             Spacing="12" Padding="40">
            <Label Text="🛒" FontSize="64" HorizontalOptions="Center"/>
            <Label Text="Your cart is empty" FontSize="18" FontAttributes="Bold"
                   TextColor="#555" HorizontalOptions="Center"/>
            <Label Text="Browse the menu and add items to get started."
                   FontSize="13" TextColor="#888" HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>
            <Button Text="Browse Menu" BackgroundColor="#b71c1c" TextColor="White"
                    CornerRadius="12" Padding="24,12" Margin="0,8"
                    Clicked="OnBrowseMenuClicked"/>
        </VerticalStackLayout>

        <!-- Cart items -->
        <ScrollView Grid.Row="1" x:Name="CartScrollView">
            <VerticalStackLayout Padding="16,12" Spacing="10">
                <CollectionView x:Name="CartList" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" BackgroundColor="White"
                                    StrokeThickness="0" Padding="14">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                    <!-- Name + portion -->
                                    <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="8">
                                        <Label Text="{Binding Name}" FontSize="14"
                                               FontAttributes="Bold" TextColor="#1a1a1a"
                                               VerticalOptions="Center"/>
                                        <Border BackgroundColor="#fce4e4" StrokeThickness="0" Padding="6,2">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Portion}" FontSize="10"
                                                   TextColor="#b71c1c" FontAttributes="Bold"/>
                                        </Border>
                                    </HorizontalStackLayout>
                                    <!-- Category -->
                                    <Label Grid.Row="1" Grid.Column="0"
                                           Text="{Binding Category}" FontSize="11"
                                           TextColor="#aaa" Margin="0,2,0,6"/>
                                    <!-- Price -->
                                    <Label Grid.Row="2" Grid.Column="0"
                                           Text="{Binding Subtotal, StringFormat='₱{0:N2}'}"
                                           FontSize="15" FontAttributes="Bold"
                                           TextColor="#b71c1c"/>
                                    <!-- Qty controls -->
                                    <HorizontalStackLayout Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                                                           Spacing="0" VerticalOptions="Center">
                                        <Button Text="−" FontSize="18" FontAttributes="Bold"
                                                BackgroundColor="#fce4e4" TextColor="#b71c1c"
                                                CornerRadius="8" WidthRequest="36" HeightRequest="36"
                                                Padding="0"
                                                CommandParameter="{Binding .}"
                                                Clicked="OnDecreaseClicked"/>
                                        <Label Text="{Binding Quantity}"
                                               FontSize="16" FontAttributes="Bold"
                                               TextColor="#1a1a1a" WidthRequest="36"
                                               HorizontalOptions="Center"
                                               HorizontalTextAlignment="Center"
                                               VerticalOptions="Center"/>
                                        <Button Text="+" FontSize="18" FontAttributes="Bold"
                                                BackgroundColor="#b71c1c" TextColor="White"
                                                CornerRadius="8" WidthRequest="36" HeightRequest="36"
                                                Padding="0"
                                                CommandParameter="{Binding .}"
                                                Clicked="OnIncreaseClicked"/>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Checkout footer -->
        <Border Grid.Row="2" x:Name="CheckoutFooter"
                BackgroundColor="White" StrokeThickness="0"
                Padding="20,16">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.08" Offset="0,-3" Radius="12"/>
            </Border.Shadow>
            <VerticalStackLayout Spacing="12">
                <!-- Order summary -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Subtotal" FontSize="13" TextColor="#888"/>
                    <Label Grid.Column="1" x:Name="SubtotalLabel"
                           FontSize="13" TextColor="#555"/>
                </Grid>
                <BoxView HeightRequest="1" Color="#f0f0f0"/>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Total" FontSize="16" FontAttributes="Bold" TextColor="#1a1a1a"/>
                    <Label Grid.Column="1" x:Name="TotalLabel"
                           FontSize="18" FontAttributes="Bold" TextColor="#b71c1c"/>
                </Grid>
                <!-- Payment method -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border x:Name="CardBtn" Grid.Column="0"
                            BackgroundColor="White" StrokeThickness="2"
                            Stroke="#b71c1c" Padding="12,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Label Text="💳" FontSize="20" HorizontalOptions="Center"/>
                            <Label Text="Card" FontSize="12" FontAttributes="Bold"
                                   TextColor="#b71c1c" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSelectCard"/>
                        </Border.GestureRecognizers>
                    </Border>
                    <Border x:Name="CopBtn" Grid.Column="1"
                            BackgroundColor="#fce4e4" StrokeThickness="2"
                            Stroke="#b71c1c" Padding="12,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Label Text="💵" FontSize="20" HorizontalOptions="Center"/>
                            <Label Text="Cash on Pick-Up" FontSize="11" FontAttributes="Bold"
                                   TextColor="#b71c1c" HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSelectCOP"/>
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>
                <!-- Place order -->
                <Button x:Name="PlaceOrderBtn"
                        Text="Place Order" FontSize="16" FontAttributes="Bold"
                        BackgroundColor="#b71c1c" TextColor="White"
                        CornerRadius="14" Padding="0,16"
                        Clicked="OnPlaceOrderClicked"/>
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
