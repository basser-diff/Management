<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Resto.App.Pages.HomePage"
             Title="RESTO"
             BackgroundColor="#f4f6fb">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Hero Banner -->
            <Grid BackgroundColor="#b71c1c" Padding="24,40,24,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo + Brand -->
                <HorizontalStackLayout Grid.Row="0" Spacing="12" VerticalOptions="Center">
                    <Border BackgroundColor="#30FFFFFF"
                            StrokeThickness="0"
                            Padding="10"
                            WidthRequest="52" HeightRequest="52">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Label Text="🍽️" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                        <Label Text="RESTO" FontSize="22" FontAttributes="Bold"
                               TextColor="White" CharacterSpacing="3"/>
                        <Label Text="Sariling Atin Restaurant" FontSize="11"
                               TextColor="#BFFFFFFF"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Welcome -->
                <Label Grid.Row="1" Text="Welcome Back! 👋"
                       FontSize="26" FontAttributes="Bold"
                       TextColor="White" Margin="0,20,0,6"/>
                <Label Grid.Row="2"
                       Text="Order your favorite Filipino dishes. Fresh and delicious, ready for pick-up!"
                       FontSize="13" TextColor="#D9FFFFFF"
                       LineBreakMode="WordWrap" Margin="0,0,0,20"/>

                <!-- Order Now button -->
                <Button Grid.Row="3"
                        Text="🛍️  Browse Menu"
                        FontSize="15" FontAttributes="Bold"
                        BackgroundColor="White"
                        TextColor="#b71c1c"
                        CornerRadius="12"
                        Padding="0,14"
                        HorizontalOptions="Fill"
                        Clicked="OnBrowseMenuClicked"/>
            </Grid>

            <!-- Quick Category Chips -->
            <VerticalStackLayout Padding="20,20,20,8" Spacing="10">
                <Label Text="Categories" FontSize="16" FontAttributes="Bold" TextColor="#1a1a1a"/>
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout x:Name="CategoryChips" Spacing="8"/>
                </ScrollView>
            </VerticalStackLayout>

            <!-- Featured Items -->
            <VerticalStackLayout Padding="20,8,20,20" Spacing="12">
                <HorizontalStackLayout>
                    <Label Text="Popular Items" FontSize="16" FontAttributes="Bold"
                           TextColor="#1a1a1a" HorizontalOptions="StartAndExpand"/>
                    <Label Text="See all →" FontSize="13" TextColor="#b71c1c"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBrowseMenuClicked"/>
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <!-- Featured cards -->
                <CollectionView x:Name="FeaturedList"
                                ItemsLayout="VerticalList"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10"
                                    BackgroundColor="White"
                                    StrokeThickness="0"
                                    Padding="14">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="12">
                                    <!-- Emoji icon -->
                                    <Border Grid.Column="0"
                                            BackgroundColor="#fce4e4"
                                            StrokeThickness="0"
                                            WidthRequest="52" HeightRequest="52"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12"/>
                                        </Border.StrokeShape>
                                        <Label Text="{Binding ImageEmoji}" FontSize="26"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <!-- Name + desc -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" FontSize="14"
                                               FontAttributes="Bold" TextColor="#1a1a1a"/>
                                        <Label Text="{Binding Description}" FontSize="11"
                                               TextColor="#888" LineBreakMode="TailTruncation" MaxLines="1"/>
                                        <Label Text="{Binding PriceFull, StringFormat='₱{0:N0}'}"
                                               FontSize="13" FontAttributes="Bold" TextColor="#b71c1c"/>
                                    </VerticalStackLayout>
                                    <!-- Add button -->
                                    <Button Grid.Column="2"
                                            Text="+" FontSize="20"
                                            BackgroundColor="#b71c1c"
                                            TextColor="White"
                                            CornerRadius="20"
                                            WidthRequest="40" HeightRequest="40"
                                            Padding="0"
                                            VerticalOptions="Center"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnQuickAddClicked"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
