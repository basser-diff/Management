@page "/manager/dashboard"
@layout ManagerLayout
@rendermode InteractiveServer
@inject DataService DataService
@inject AuthService AuthService
@inject NavigationManager Nav

<PageTitle>Dashboard — RESTO</PageTitle>

<!-- ── Page header ──────────────────────────────────────────────────────── -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-0">Dashboard</h4>
        <small class="text-muted">Welcome back, @AuthService.CurrentManager?.FullName</small>
    </div>
    <span class="text-muted small">
        <i class="bi bi-calendar3 me-1"></i>@DateTime.Now.ToString("MMMM dd, yyyy")
    </span>
</div>

<!-- ── Stats cards ───────────────────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm h-100 stat-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-success-subtle text-success">
                    <i class="bi bi-currency-dollar"></i>
                </div>
                <div>
                    <div class="text-muted small">Total Sales</div>
                    <div class="fs-4 fw-bold">₱@DataService.TotalSales.ToString("N2")</div>
                    <div class="text-success small"><i class="bi bi-arrow-up-short"></i>+12% vs last week</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm h-100 stat-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-danger-subtle text-danger">
                    <i class="bi bi-wallet2"></i>
                </div>
                <div>
                    <div class="text-muted small">Total Expenses</div>
                    <div class="fs-4 fw-bold">₱@DataService.TotalExpenses.ToString("N2")</div>
                    <div class="text-muted small"><i class="bi bi-dash-lg"></i> 55% of sales</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm h-100 stat-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-primary-subtle text-primary">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <div>
                    <div class="text-muted small">Total Profit</div>
                    <div class="fs-4 fw-bold">₱@DataService.TotalProfit.ToString("N2")</div>
                    <div class="text-primary small"><i class="bi bi-arrow-up-short"></i>+8% vs last week</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── Quick stat badges ──────────────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="fs-3 fw-bold text-danger">@DataService.Orders.Count</div>
            <div class="small text-muted">Total Orders</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="fs-3 fw-bold text-warning">
                @DataService.Orders.Count(o => o.Status == OrderStatus.Pending)
            </div>
            <div class="small text-muted">Pending Orders</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="fs-3 fw-bold text-success">
                @DataService.Orders.Count(o => o.Status == OrderStatus.Completed)
            </div>
            <div class="small text-muted">Completed Orders</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="fs-3 fw-bold text-info">@DataService.Products.Count(p => p.IsAvailable)</div>
            <div class="small text-muted">Active Products</div>
        </div>
    </div>
</div>

<!-- ── Chart + Recent Orders ─────────────────────────────────────────────── -->
<div class="row g-3 mb-4">

    <!-- Sales chart (pure CSS bar chart) -->
    <div class="col-12 col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 pt-3 pb-0">
                <h6 class="fw-bold mb-0">Weekly Sales</h6>
                <small class="text-muted">Last 7 days</small>
            </div>
            <div class="card-body">
                @{
                    var sales   = DataService.WeeklySales();
                    var maxSale = sales.Max(s => s.Amount);
                }
                <div class="d-flex align-items-end gap-2 justify-content-between" style="height:140px;">
                    @foreach (var (day, amount) in sales)
                    {
                        var pct = maxSale > 0 ? (double)amount / (double)maxSale * 100 : 0;
                        <div class="d-flex flex-column align-items-center flex-grow-1 h-100 justify-content-end">
                            <div class="text-muted" style="font-size:10px;">₱@((amount/1000).ToString("0.0"))k</div>
                            <div class="chart-bar rounded-top"
                                 style="height:@pct%;background:linear-gradient(to top,#b71c1c,#ef5350);width:100%;min-height:4px;"
                                 title="@day: ₱@amount.ToString("N0")">
                            </div>
                            <div class="text-muted mt-1" style="font-size:11px;">@day</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Recent orders -->
    <div class="col-12 col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 d-flex align-items-center justify-content-between pt-3 pb-0">
                <div>
                    <h6 class="fw-bold mb-0">Recent Orders</h6>
                    <small class="text-muted">Latest customer orders</small>
                </div>
                <a href="/manager/orders" class="btn btn-sm btn-outline-danger">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3 small">Order</th>
                                <th class="small">Customer</th>
                                <th class="small">Items</th>
                                <th class="small">Total</th>
                                <th class="small">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in DataService.Orders.OrderByDescending(o => o.OrderDate).Take(6))
                            {
                                <tr>
                                    <td class="ps-3 small fw-semibold text-danger">#@order.Id</td>
                                    <td class="small">@order.CustomerName</td>
                                    <td class="small text-muted">
                                        @string.Join(", ", order.Items.Select(i => i.ProductName).Take(2))
                                        @(order.Items.Count > 2 ? $" +{order.Items.Count - 2}" : "")
                                    </td>
                                    <td class="small fw-semibold">₱@order.Total.ToString("N0")</td>
                                    <td><span class="badge @GetStatusBadge(order.Status)">@order.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── Low stock alerts ───────────────────────────────────────────────────── -->
@{
    var lowStock = DataService.Inventory
        .Where(i => i.Status != StockStatus.InStock)
        .OrderBy(i => i.Stock)
        .ToList();
}
@if (lowStock.Any())
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-0 d-flex align-items-center justify-content-between pt-3 pb-0">
            <div>
                <h6 class="fw-bold mb-0 text-warning">
                    <i class="bi bi-exclamation-triangle me-1"></i>Stock Alerts
                </h6>
                <small class="text-muted">Items needing attention</small>
            </div>
            <a href="/manager/inventory" class="btn btn-sm btn-outline-warning">Manage Stock</a>
        </div>
        <div class="card-body">
            <div class="row g-2">
                @foreach (var item in lowStock.Take(6))
                {
                    <div class="col-12 col-sm-6 col-md-4">
                        <div class="d-flex align-items-center gap-2 p-2 rounded border @(item.Status == StockStatus.OutOfStock ? "border-danger bg-danger-subtle" : "border-warning bg-warning-subtle")">
                            <i class="bi @(item.Status == StockStatus.OutOfStock ? "bi-x-circle-fill text-danger" : "bi-exclamation-circle-fill text-warning")"></i>
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="small fw-semibold text-truncate">@item.Name</div>
                                <div class="small text-muted">Stock: @item.Stock</div>
                            </div>
                            <span class="badge @(item.Status == StockStatus.OutOfStock ? "bg-danger" : "bg-warning text-dark")">
                                @item.Status
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        DataService.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !AuthService.IsAuthenticated)
        {
            Nav.NavigateTo("/manager/login", forceLoad: true);
            await Task.CompletedTask;
        }
    }

    public void Dispose() => DataService.OnChange -= StateHasChanged;

    private string GetStatusBadge(OrderStatus status) => status switch
    {
        OrderStatus.Pending        => "bg-secondary",
        OrderStatus.Confirmed      => "bg-primary",
        OrderStatus.Preparing      => "bg-warning text-dark",
        OrderStatus.ReadyForPickup => "bg-info text-dark",
        OrderStatus.Completed      => "bg-success",
        OrderStatus.Cancelled      => "bg-danger",
        _                          => "bg-secondary",
    };
}

<style>
    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
    }

    .stat-card {
        transition: transform 0.15s, box-shadow 0.15s;
    }

    .stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.10) !important;
    }

    .chart-bar {
        transition: height 0.6s ease;
    }
</style>
