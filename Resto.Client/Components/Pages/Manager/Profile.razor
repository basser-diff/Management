@page "/manager/profile"
@layout ManagerLayout
@rendermode InteractiveServer
@inject AuthService AuthService
@inject NavigationManager Nav

<PageTitle>Profile — RESTO</PageTitle>

<div class="row g-3 justify-content-center">
    <div class="col-12 col-lg-8">

        <!-- ── Profile header card ──────────────────────────────────────── -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body d-flex align-items-center gap-4 p-4">
                <div class="profile-avatar-lg">
                    @(AuthService.CurrentManager?.FullName?.Substring(0,1).ToUpper() ?? "M")
                </div>
                <div>
                    <h5 class="fw-bold mb-0">@AuthService.CurrentManager?.FullName</h5>
                    <div class="text-muted small">@AuthService.CurrentManager?.Email</div>
                    <div class="mt-2">
                        <span class="badge bg-danger px-3 py-1">
                            <i class="bi bi-shield-fill me-1"></i>
                            @AuthService.CurrentManager?.Role
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Edit Profile ─────────────────────────────────────────────── -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white border-0 pt-3 pb-0">
                <h6 class="fw-bold mb-0">
                    <i class="bi bi-person me-1 text-danger"></i> Personal Information
                </h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12 col-sm-6">
                        <label class="form-label small fw-semibold">Full Name</label>
                        <input type="text" class="form-control" @bind="_fullName" />
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label small fw-semibold">Email Address</label>
                        <input type="email" class="form-control bg-light" value="@AuthService.CurrentManager?.Email" disabled />
                        <div class="form-text">Email cannot be changed.</div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label small fw-semibold">Phone Number</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-phone text-muted"></i></span>
                            <input type="tel" class="form-control" @bind="_phone" placeholder="+63 9XX XXX XXXX" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label small fw-semibold">Role</label>
                        <input type="text" class="form-control bg-light" value="@AuthService.CurrentManager?.Role" disabled />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_profileSuccess))
                {
                    <div class="alert alert-success py-2 mt-3 small">
                        <i class="bi bi-check-circle me-1"></i>@_profileSuccess
                    </div>
                }

                <div class="mt-3">
                    <button class="btn btn-danger px-4" @onclick="SaveProfile">
                        <i class="bi bi-check-lg me-1"></i> Save Changes
                    </button>
                </div>
            </div>
        </div>

        <!-- ── Change Password ──────────────────────────────────────────── -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white border-0 pt-3 pb-0">
                <h6 class="fw-bold mb-0">
                    <i class="bi bi-shield-lock me-1 text-danger"></i> Change Password
                </h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Current Password</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock text-muted"></i></span>
                            <input type="@(_showCurrent ? "text" : "password")"
                                   class="form-control"
                                   @bind="_currentPassword"
                                   placeholder="Enter current password" />
                            <button type="button" class="input-group-text bg-light"
                                    @onclick="() => _showCurrent = !_showCurrent">
                                <i class="bi @(_showCurrent ? "bi-eye-slash" : "bi-eye") text-muted"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label small fw-semibold">New Password</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock-fill text-muted"></i></span>
                            <input type="@(_showNew ? "text" : "password")"
                                   class="form-control"
                                   @bind="_newPassword"
                                   placeholder="At least 6 characters" />
                            <button type="button" class="input-group-text bg-light"
                                    @onclick="() => _showNew = !_showNew">
                                <i class="bi @(_showNew ? "bi-eye-slash" : "bi-eye") text-muted"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label small fw-semibold">Confirm New Password</label>
                        <input type="password" class="form-control"
                               @bind="_confirmPassword"
                               placeholder="Re-enter new password" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_pwError))
                {
                    <div class="alert alert-danger py-2 mt-3 small">
                        <i class="bi bi-exclamation-circle me-1"></i>@_pwError
                    </div>
                }
                @if (!string.IsNullOrEmpty(_pwSuccess))
                {
                    <div class="alert alert-success py-2 mt-3 small">
                        <i class="bi bi-check-circle me-1"></i>@_pwSuccess
                    </div>
                }

                <div class="mt-3">
                    <button class="btn btn-danger px-4" @onclick="ChangePassword">
                        <i class="bi bi-key me-1"></i> Update Password
                    </button>
                </div>
            </div>
        </div>

        <!-- ── Danger zone ──────────────────────────────────────────────── -->
        <div class="card border-0 shadow-sm border-danger border-opacity-25">
            <div class="card-header bg-white border-0 pt-3 pb-0">
                <h6 class="fw-bold mb-0 text-danger">
                    <i class="bi bi-exclamation-triangle me-1"></i> Session
                </h6>
            </div>
            <div class="card-body">
                <p class="small text-muted mb-3">Sign out from the current manager session.</p>
                <button class="btn btn-outline-danger" @onclick="Logout">
                    <i class="bi bi-box-arrow-left me-1"></i> Log Out
                </button>
            </div>
        </div>

    </div>
</div>

@code {
    private string _fullName        = string.Empty;
    private string _phone           = string.Empty;
    private string _currentPassword = string.Empty;
    private string _newPassword     = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool   _showCurrent     = false;
    private bool   _showNew         = false;
    private string _profileSuccess  = string.Empty;
    private string _pwError         = string.Empty;
    private string _pwSuccess       = string.Empty;

    protected override void OnInitialized()
    {
        if (!AuthService.IsAuthenticated) { Nav.NavigateTo("/manager/login", forceLoad: true); return; }
        _fullName = AuthService.CurrentManager?.FullName ?? string.Empty;
        _phone    = AuthService.CurrentManager?.Phone    ?? string.Empty;
    }

    private async Task SaveProfile()
    {
        if (string.IsNullOrWhiteSpace(_fullName))
        { _profileSuccess = string.Empty; return; }

        AuthService.UpdateProfile(_fullName, _phone);
        _profileSuccess = "Profile updated successfully.";
        await Task.Delay(3000);
        _profileSuccess = string.Empty;
        StateHasChanged();
    }

    private async Task ChangePassword()
    {
        _pwError   = string.Empty;
        _pwSuccess = string.Empty;

        if (_newPassword != _confirmPassword)
        { _pwError = "New passwords do not match."; return; }

        var error = AuthService.ChangePassword(_currentPassword, _newPassword);
        if (error is not null) { _pwError = error; return; }

        _pwSuccess       = "Password changed successfully.";
        _currentPassword = string.Empty;
        _newPassword     = string.Empty;
        _confirmPassword = string.Empty;

        await Task.Delay(3000);
        _pwSuccess = string.Empty;
        StateHasChanged();
    }

    private void Logout()
    {
        AuthService.Logout();
        Nav.NavigateTo("/manager/login");
    }
}

<style>
    .profile-avatar-lg {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #d32f2f, #b71c1c);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 36px;
        font-weight: 700;
        flex-shrink: 0;
        box-shadow: 0 4px 16px rgba(211,47,47,0.35);
    }
</style>
