@page "/manager/login"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using Resto.Client.Models

@inject HttpClient Http
@inject NavigationManager Nav
@inject AuthService AuthService

<PageTitle>Manager Login — RESTO</PageTitle>

<div class="login-bg d-flex align-items-center justify-content-center min-vh-100">

    <div class="login-card card shadow-lg border-0 p-4">

        <!-- LOGO -->
        <div class="text-center mb-4">

            <div class="login-logo mb-2">
                <img src="images/resto-logo.svg"
                     alt="RESTO Logo" />
            </div>

            <h4 class="fw-bold text-danger mb-0">
                RESTO
            </h4>

            <small class="text-muted">
                Sariling Atin Restaurant
            </small>

            <div class="mt-2">

                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1">
                    Manager Portal
                </span>

            </div>

        </div>


        <!-- ERROR MESSAGE -->
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 py-2">

                <i class="bi bi-exclamation-circle-fill"></i>

                <span>
                    @_errorMessage
                </span>

            </div>
        }


        <!-- LOGIN FORM -->
        <EditForm Model="_model"
                  OnValidSubmit="HandleLogin"
                  FormName="manager-login">

            <DataAnnotationsValidator />


            <!-- EMAIL -->
            <div class="mb-3">

                <label class="form-label fw-semibold">
                    Email Address
                </label>

                <div class="input-group">

                    <span class="input-group-text bg-light border-end-0">
                        <i class="bi bi-envelope text-muted"></i>
                    </span>

                    <InputText @bind-Value="_model.Email"
                               class="form-control border-start-0 ps-0"
                               placeholder="manager@email.com"
                               autocomplete="username" />

                </div>

                <ValidationMessage For="() => _model.Email"
                                   class="text-danger small mt-1" />

            </div>


            <!-- PASSWORD -->
            <div class="mb-4">

                <label class="form-label fw-semibold">
                    Password
                </label>

                <div class="input-group">

                    <span class="input-group-text bg-light border-end-0">
                        <i class="bi bi-lock text-muted"></i>
                    </span>

                    <InputText @bind-Value="_model.Password"
                               type="@(_showPassword ? "text" : "password")"
                               class="form-control border-start-0 border-end-0 ps-0"
                               placeholder="Enter password"
                               autocomplete="current-password" />

                    <button type="button"
                            class="input-group-text bg-light border-start-0"
                            @onclick="TogglePassword"
                            title="Show / Hide Password">

                        <i class="bi @(_showPassword ? "bi-eye-slash" : "bi-eye") text-muted">
                        </i>

                    </button>

                </div>

                <ValidationMessage For="() => _model.Password"
                                   class="text-danger small mt-1" />

            </div>


            <!-- LOGIN BUTTON -->
            <button type="submit"
                    class="btn btn-danger w-100 py-2 fw-semibold"
                    disabled="@_isLoading">

                @if (_isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2">
                    </span>

                    <span>
                        Signing in...
                    </span>
                }
                else
                {
                    <i class="bi bi-box-arrow-in-right me-2"></i>

                    <span>
                        Sign In
                    </span>
                }

            </button>

        </EditForm>


        <!-- INFO -->
        <div class="text-center mt-3">

            <small class="text-muted">

                <i class="bi bi-shield-lock me-1"></i>

                Manager authentication is handled securely by the API.

            </small>

        </div>

    </div>

</div>


@code {

    // ============================================================
    // LOGIN MODEL
    // ============================================================

    private LoginModel _model = new();


    // ============================================================
    // UI STATE
    // ============================================================

    private string _errorMessage = string.Empty;

    private bool _isLoading = false;

    private bool _showPassword = false;


    // ============================================================
    // LOGIN
    // ============================================================

    private async Task HandleLogin()
    {
        if (_isLoading)
            return;

        _isLoading = true;
        _errorMessage = string.Empty;

        try
        {
            // ====================================================
            // CALL Resto.API
            //
            // POST:
            // /api/Auth/login
            // ====================================================

            var response =
                await Http.PostAsJsonAsync(
                    "api/Auth/login",
                    new
                    {
                        Email = _model.Email,
                        Password = _model.Password
                    });



            if (!response.IsSuccessStatusCode)
            {
                if (response.StatusCode ==
                    System.Net.HttpStatusCode.Unauthorized)
                {
                    _errorMessage =
                        "Invalid email or password.";
                }
                else
                {
                    _errorMessage =
                        "Unable to connect to the login service.";
                }

                return;
            }

            var result =
                await response.Content
                    .ReadFromJsonAsync<
                        ApiResponse<LoginResponse>>();


            if (result == null ||
                result.Data == null)
            {
                _errorMessage =
                    "Invalid response from the server.";

                return;
            }


            // ====================================================
            // LOGIN SUCCESS
            // ====================================================

            var manager = result.Data;

            AuthService.SetAuthenticatedManager(manager);



            Nav.NavigateTo(
                "/manager/dashboard",
                forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _errorMessage =
                "Cannot connect to Resto.API. " +
                "Make sure the API is running.";
        }
        catch (Exception ex)
        {
            _errorMessage =
                "Login failed: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }


    // ============================================================
    // PASSWORD VISIBILITY
    // ============================================================

    private void TogglePassword()
    {
        _showPassword = !_showPassword;
    }


    // ============================================================
    // LOGIN MODEL
    // ============================================================

    private class LoginModel
    {
        [Required(
            ErrorMessage = "Email is required.")]
        [EmailAddress(
            ErrorMessage = "Enter a valid email.")]
        public string Email { get; set; } = string.Empty;


        [Required(
            ErrorMessage = "Password is required.")]
        public string Password { get; set; } = string.Empty;
    }
}


<style>

    .login-bg {
        background: linear-gradient( 135deg, #b71c1c 0%, #d32f2f 40%, #7f0000 100% );
        min-height: 100vh;
    }


    .login-card {
        width: 100%;
        max-width: 420px;
        border-radius: 16px;
        animation: fadeInUp 0.4s ease-out;
    }


    .login-logo {
        width: 72px;
        height: 72px;
        background: linear-gradient( 135deg, #d32f2f, #b71c1c );
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 16px rgba(211,47,47,0.4);
    }


        .login-logo img {
            width: 72px;
            height: 72px;
            object-fit: contain;
            border-radius: 20px;
        }


    .input-group-text {
        cursor: default;
    }


    .input-group button {
        cursor: pointer;
    }


    @@keyframes fadeInUp {

        from {
            opacity: 0;
            transform: translateY(24px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>